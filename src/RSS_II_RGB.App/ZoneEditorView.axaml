<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RSS_II_RGB.App"
             xmlns:p="using:Avalonia.Controls.Primitives"
             x:Class="RSS_II_RGB.App.ZoneEditorView"
             x:DataType="vm:ZoneEditorViewModel">
    <Grid ColumnDefinitions="290,*" ColumnSpacing="14">
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="section" Text="{x:Static vm:L.EditSelectionTitle}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" Text="{Binding SelectionText}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static vm:L.EditingHint}" IsVisible="{Binding IsEditing}" Foreground="#FF7A8E" FontSize="11"/>
                    </Grid>
                    <TextBlock Text="{x:Static vm:L.ZoneEffectLabel}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <ComboBox Focusable="False" ItemsSource="{Binding ZoneEffects}" SelectedItem="{Binding ZoneEffect}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:EffectChoice"><TextBlock Text="{Binding Converter={x:Static vm:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding AudioModeOptions}" SelectedItem="{Binding SelectedAudioMode}" IsVisible="{Binding IsAudioMode}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AudioZoneMode"><TextBlock Text="{Binding Converter={x:Static vm:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="RegionOptionsButton" Classes="quiet" Content="{x:Static vm:L.ZoneAdjustLabel}" HorizontalAlignment="Stretch" Focusable="False">
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop" FlyoutPresenterClasses="region-options">
                                <ScrollViewer MaxHeight="540" Width="460" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="14"><vm:ZoneEffectParametersView/><Button Classes="primary" Content="{Binding ApplyText}" IsEnabled="{Binding CanAssign}" Click="OnApplyZoneParameters" HorizontalAlignment="Stretch" Focusable="False"/></StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{x:Static vm:L.ColourLabel}" FontWeight="SemiBold"/><CheckBox Grid.Column="1" Content="{x:Static vm:L.RainbowColorsLabel}" IsChecked="{Binding ZoneRainbow}" IsVisible="{Binding ZoneHasRainbow}" Focusable="False"/></Grid>
                    <Grid ColumnDefinitions="*,22" ColumnSpacing="10" Height="150">
                        <p:ColorSpectrum HsvColor="{Binding ZoneHsvColor, Mode=TwoWay}" Components="SaturationValue"/>
                        <p:ColorSlider Grid.Column="1" HsvColor="{Binding ZoneHsvColor, Mode=TwoWay}"
                                       ColorModel="Hsva" ColorComponent="Component1" Orientation="Vertical"
                                       IsAlphaVisible="False" IsPerceptive="True"/>
                    </Grid>
                    <TextBox Text="{Binding ZoneColorHex}" Watermark="#4CE6B5"/>
                    <TextBlock Text="{Binding ColorError}" IsVisible="{Binding HasColorError}" Foreground="#FF7387" TextWrapping="Wrap" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="swatch" Background="#4CE6B5" Command="{Binding SetColorCommand}" CommandParameter="#4CE6B5" ToolTip.Tip="{x:Static vm:L.ColorGreen}"/>
                        <Button Classes="swatch" Background="#FF668C" Command="{Binding SetColorCommand}" CommandParameter="#FF668C" ToolTip.Tip="{x:Static vm:L.ColorRed}"/>
                        <Button Classes="swatch" Background="#A990FF" Command="{Binding SetColorCommand}" CommandParameter="#A990FF" ToolTip.Tip="{x:Static vm:L.ColorMagenta}"/>
                        <Button Classes="swatch" Background="#4CABFF" Command="{Binding SetColorCommand}" CommandParameter="#4CABFF" ToolTip.Tip="{x:Static vm:L.ColorBlue}"/>
                        <Button Classes="swatch" Background="#FFCA62" Command="{Binding SetColorCommand}" CommandParameter="#FFCA62"/>
                        <Button Classes="swatch" Background="#F4F7FF" Command="{Binding SetColorCommand}" CommandParameter="#F4F7FF" ToolTip.Tip="{x:Static vm:L.ColorWhite}"/>
                    </StackPanel>
                    <Button Classes="primary" Content="{Binding ApplyText}" Command="{Binding AssignZoneCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Classes="muted" Text="{x:Static vm:L.ApplyHint}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Classes="section" Text="{x:Static vm:L.ZonesHeader}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="quiet" Content="{x:Static vm:L.NewZone}" Command="{Binding SelectNoneCommand}"/>
                    <Button Grid.Column="2" Classes="quiet" Content="{x:Static vm:L.RemoveAllZones}" Command="{Binding ClearZonesCommand}" IsEnabled="{Binding HasZones}"/>
                </Grid>
                <StackPanel Spacing="8" IsVisible="{Binding CanSelectBarSegments}" IsEnabled="{Binding CanSelectKeys}">
                    <TextBlock Text="{x:Static vm:L.StripSegmentsLabel}" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static vm:L.StripSelectionHint}" Classes="muted" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding StripZoneSegments}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:KeyVM"><ToggleButton Classes="key" IsChecked="{Binding IsSelected}" Content="{Binding ShortLabel}" Background="{Binding PreviewBrush}" Foreground="{Binding PreviewForeground}" ToolTip.Tip="{Binding Name}" MinWidth="28" Height="34" Margin="1" Focusable="False"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Classes="muted" Text="{x:Static vm:L.EmptyZonesHint}" IsVisible="{Binding HasNoZones}" Margin="0,5"/>
                <ItemsControl ItemsSource="{Binding ZoneRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ZoneRowVM">
                            <Grid ColumnDefinitions="28,*,Auto" Margin="0,3" ColumnSpacing="10">
                                <Border Background="{Binding Swatch}" CornerRadius="5" Height="24" Width="28" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{Binding Summary}" Command="{Binding EditCommand}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Background="#252A34" ToolTip.Tip="{x:Static vm:L.EditZone}"/>
                                <Button Grid.Column="2" Classes="quiet" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static vm:L.RemoveZone}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
