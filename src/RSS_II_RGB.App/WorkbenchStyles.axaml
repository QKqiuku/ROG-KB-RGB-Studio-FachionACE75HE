<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RSS_II_RGB.App">
    <Styles.Resources>
        <!-- Original keycap mark and generic eye indicator; no third-party logo artwork. -->
        <StreamGeometry x:Key="AppMarkGeometry">M14,30 L22,30 Q28,30 28,36 L28,64 Q28,70 22,70 L14,70 Q8,70 8,64 L8,36 Q8,30 14,30 Z M44,10 L52,10 Q58,10 58,16 L58,64 Q58,70 52,70 L44,70 Q38,70 38,64 L38,16 Q38,10 44,10 Z M74,24 L82,24 Q88,24 88,30 L88,64 Q88,70 82,70 L74,70 Q68,70 68,64 L68,30 Q68,24 74,24 Z M14,80 L82,80 Q86,80 86,84 Q86,88 82,88 L14,88 Q10,88 10,84 Q10,80 14,80 Z</StreamGeometry>
        <StreamGeometry x:Key="RogEyeGeometry">M2,20 C16,2 48,2 62,20 C48,38 16,38 2,20 Z M10,20 C22,9 42,9 54,20 C42,31 22,31 10,20 Z M38,20 A6,6 0 1 0 26,20 A6,6 0 1 0 38,20 Z</StreamGeometry>
        <SolidColorBrush x:Key="RogAccentBrush" Color="#E6002D"/>
    </Styles.Resources>
    <Style Selector="Window.workbench">
        <Setter Property="Background" Value="#090A0D"/>
        <Setter Property="Foreground" Value="#F0F2F6"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
    </Style>
    <!-- Lighting changes are pointer-operated; text boxes retain normal typing/navigation. -->
    <Style Selector="Window.workbench :is(Button), Window.workbench Slider, Window.workbench ComboBox, Window.workbench ListBox, Window.workbench ListBoxItem, Window.workbench Expander">
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="FlyoutPresenter.region-options">
        <Setter Property="MaxWidth" Value="600"/>
        <Setter Property="Background" Value="#14161C"/>
        <Setter Property="Foreground" Value="#F0F2F6"/>
        <Setter Property="BorderBrush" Value="#303641"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="#14161C"/>
        <Setter Property="BorderBrush" Value="#303641"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="22"/>
    </Style>
    <Style Selector="Border.keyboard-shell">
        <Setter Property="Background" Value="#0E1015"/>
        <Setter Property="BorderBrush" Value="#343945"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BoxShadow" Value="0 5 18 0 #80000000"/>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="#A0A6B2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#D80E2B"/>
        <Setter Property="Foreground" Value="#F4F6FA"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F52A46"/>
    </Style>
    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#353B47"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="ListBox.frame-rate">
        <Setter Property="Background" Value="#171A21"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="ListBox.frame-rate ListBoxItem">
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B3B9C4"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.frame-rate ListBoxItem:pointerover">
        <Setter Property="Background" Value="#2D323D"/>
    </Style>
    <Style Selector="ListBox.frame-rate ListBoxItem:selected">
        <Setter Property="Background" Value="#D80E2B"/>
        <Setter Property="Foreground" Value="#F4F6FA"/>
    </Style>
    <Style Selector="ListBox.frame-rate ListBoxItem:focus-visible">
        <Setter Property="Background" Value="#842039"/>
        <Setter Property="Foreground" Value="#F4F6FA"/>
    </Style>
    <Style Selector="ToggleButton.key" x:DataType="vm:KeyVM">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#404652"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The theme's hover/checked fills would mask the sent RGB colour. -->
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.key:pointerover">
        <Setter Property="BorderBrush" Value="#FF526A"/>
    </Style>
    <Style Selector="ToggleButton.key:checked">
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#636C7A"/>
    </Style>
    <Style Selector="Button.preset">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="#20242D"/>
        <Setter Property="Foreground" Value="#DEE2EA"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,9"/>
        <Setter Property="MinHeight" Value="37"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.preset:pointerover">
        <Setter Property="Background" Value="#303642"/>
    </Style>
    <Style Selector="Button.preset.selected">
        <Setter Property="Background" Value="#D80E2B"/>
        <Setter Property="Foreground" Value="#F4F6FA"/>
    </Style>
</Styles>
